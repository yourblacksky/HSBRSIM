<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <AssemblyName>HrSRLAdviser</AssemblyName>
    <RootNamespace>HrSRLAdviser</RootNamespace>
    <OutputType>Library</OutputType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <PropertyGroup>
    <!-- HDT binaries are in LocalAppData; plugins are loaded from AppData (Roaming) -->
    <HdtBinPath Condition="'$(HdtBinPath)' == ''">$(LocalAppData)\HearthstoneDeckTracker\app-1.52.15</HdtBinPath>
    <HdtPluginPath Condition="'$(HdtPluginPath)' == ''">$(AppData)\HearthstoneDeckTracker\Plugins\HrSRLAdviser</HdtPluginPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="HearthstoneDeckTracker">
      <HintPath>$(HdtBinPath)\HearthstoneDeckTracker.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HearthDb">
      <HintPath>$(HdtBinPath)\HearthDb.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HearthMirror">
      <HintPath>$(HdtBinPath)\HearthMirror.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- Copy output to HDT Plugins folder after build -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <MakeDir Directories="$(HdtPluginPath)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(HdtPluginPath)" />
    <Copy SourceFiles="$(ProjectDir)plugin.json" DestinationFolder="$(HdtPluginPath)" />
  </Target>

</Project>
